<Window x:Class="DeepSeekDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DeepSeek Desktop"
        Height="800" Width="1200"
        MinHeight="480" MinWidth="640"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuFgBrush" Color="#1A1F26"/>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="Transparent" Padding="6,4">
            <MenuItem Header="Archivo" Foreground="{DynamicResource MenuFgBrush}">
                <MenuItem Header="Recargar página" Foreground="#1A1F26" Click="Reload_Click"/>
                <MenuItem Header="Abrir en el navegador" Foreground="#1A1F26" Click="OpenInBrowser_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Foreground="#1A1F26" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Ayuda" Foreground="{DynamicResource MenuFgBrush}">
                <MenuItem Header="Soporte" Foreground="#1A1F26" Click="Support_Click"/>
                <MenuItem Header="Acerca de Estalingrado Corp" Foreground="#1A1F26" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <wv2:WebView2 x:Name="WebView"
                       Source="https://chat.deepseek.com/"
                       CoreWebView2InitializationCompleted="WebView_InitializationCompleted" />
    </DockPanel>
</Window>