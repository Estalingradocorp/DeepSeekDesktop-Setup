<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeepSeekDesktop</AssemblyName>
    <RootNamespace>DeepSeekDesktop</RootNamespace>
    <ApplicationIcon>Assets\deepseek.ico</ApplicationIcon>
    <Product>DeepSeek Desktop</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-estalingrado.jpg" />
  </ItemGroup>

</Project>