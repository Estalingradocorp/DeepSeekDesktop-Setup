<Window x:Class="DeepSeekDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de Estalingrado Corp"
        Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#1B222A"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="#6A7A8A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0B66C3"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E2E6EA"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Border Width="54" Height="54" Background="White" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,16,0">
                    <Image Source="pack://application:,,,/Assets/logo-estalingrado.jpg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Estalingrado Corp" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMainBrush}"/>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="10,0,0,0"
                                Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.3" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Launcher de escritorio para DeepSeek" FontSize="12.5"
                               Foreground="{DynamicResource TextSoftBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pie -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <TextBlock Text="© 2026 Estalingrado Corp. Todos los derechos reservados."
                           FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSoftBrush}"/>
                <Button Content="Cerrar" Click="Close_Click"
                        HorizontalAlignment="Right" Width="96" Height="32"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">

                <TextBlock Style="{StaticResource SectionTitle}" Text="Sobre esta aplicación"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextMainBrush}">
                    <Run Text="DeepSeek Desktop es el lanzador oficial de Estalingrado Corp para el acceso a "/>
                    <Hyperlink Foreground="{DynamicResource AccentBrush}" NavigateUri="https://chat.deepseek.com/"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="chat.deepseek.com"/>
                    </Hyperlink>
                    <Run Text=". Reúne el chat de DeepSeek en una ventana nativa de Windows sin necesidad de abrir el navegador."/>
                </TextBlock>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Qué es Estalingrado Corp"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource TextMainBrush}"
                           Text="Estalingrado Corp desarrolla herramientas de escritorio y utilidades para simplificar el día a día de sus equipos."/>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="DeepSeek"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMainBrush}"
                           Text="DeepSeek es una empresa de inteligencia artificial que desarrolla modelos de lenguaje avanzados y de código abierto, accesibles a través de chat.deepseek.com."/>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                           Foreground="{DynamicResource TextSoftBrush}"
                           Text="Este launcher es una herramienta de acceso de Estalingrado Corp; DeepSeek es una marca y servicio independientes."/>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Enlaces útiles"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Style="{StaticResource LinkButton}" Click="Website_Click"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            Margin="0,0,12,0" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sitio web de la empresa" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Click="Support_Click"
                            Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="Centro de soporte" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSoftBrush}"
                           Text="Para dudas o asistencia técnica, visita el centro de soporte de Estalingrado Corp."/>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Características"/>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSoftBrush}"
                           Text="•  Se adapta al modo claro u oscuro de Windows&#10;•  Recuerda el tamaño y la posición de la ventana&#10;•  API local en localhost para integración&#10;•  No requiere instalar .NET (es autocontenido)"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>