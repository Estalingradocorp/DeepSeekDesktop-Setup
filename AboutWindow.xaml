<Window x:Class="DeepSeekDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de Estalingrado Corp"
        Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#1B222A"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="#6A7A8A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0B66C3"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E2E6EA"/>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}" Padding="28,22">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" Background="White" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" Margin="0,0,16,0">
                    <Image Source="pack://application:,,,/Assets/logo-estalingrado.jpg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Estalingrado Corp" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="Launcher de escritorio para DeepSeek" FontSize="12.5"
                               Foreground="{DynamicResource TextSoftBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pie -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <TextBlock Text="Versión 1.0.3" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSoftBrush}"/>
                <Button Content="Cerrar" Click="Close_Click"
                        HorizontalAlignment="Right" Width="96" Height="32"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22">
                <TextBlock Text="Qué hace este launcher" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,18"
                           Foreground="{DynamicResource TextMainBrush}">
                    <Run Text="DeepSeek Desktop es el lanzador oficial de Estalingrado Corp para el acceso a "/>
                    <Hyperlink Foreground="{DynamicResource AccentBrush}">
                        <Run Text="chat.deepseek.com"/>
                    </Hyperlink>
                    <Run Text=". Reúne el chat de DeepSeek en una ventana nativa de Windows sin necesidad de abrir el navegador."/>
                </TextBlock>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,18"/>

                <TextBlock Text="Qué es Estalingrado Corp" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,18"
                           Foreground="{DynamicResource TextMainBrush}"
                           Text="Estalingrado Corp desarrolla herramientas de escritorio y utilidades para simplificar el día a día de sus equipos."/>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,18"/>

                <TextBlock Text="DeepSeek" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextMainBrush}"
                           Text="DeepSeek es una empresa de inteligencia artificial que desarrolla modelos de lenguaje avanzados y de código abierto, accesibles a través de chat.deepseek.com."/>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                           Foreground="{DynamicResource TextSoftBrush}"
                           Text="Este launcher es una herramienta de acceso de Estalingrado Corp; DeepSeek es una marca y servicio independientes."/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Características" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSoftBrush}"
                           Text="•  Se adapta al modo claro u oscuro de Windows&#10;•  Recuerda el tamaño y la posición de la ventana&#10;•  API local en localhost para integración&#10;•  No requiere instalar .NET (es autocontenido)"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>