<Window x:Class="DeepSeekDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de"
        Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="TextMain" Color="#1A1F26"/>
        <SolidColorBrush x:Key="TextSoft" Color="#5A6A7A"/>
        <SolidColorBrush x:Key="Accent" Color="#1F5CFF"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="56" Height="56" CornerRadius="12" Background="White" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/logo-estalingrado.jpg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Estalingrado Corp" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="Launcher de escritorio para DeepSeek" FontSize="13" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Qué hace este launcher"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                               Text="DeepSeek Desktop es el lanzador oficial de Estalingrado Corp para el acceso a chat.deepseek.com. Reúne el chat de DeepSeek en una ventana nativa de Windows sin necesidad de abrir el navegador."/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• Se adapta al modo claro u oscuro de Windows&#10;• Recuerda el tamaño y la posición de la ventana&#10;• Acelera el acceso con lanzamiento directo de la web&#10;• No requiere instalar .NET (es autocontenido)"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Qué es Estalingrado Corp"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="Estalingrado Corp desarrolla herramientas de escritorio y utilidades internas para simplificar el día a día de sus equipos."/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="DeepSeek"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                               Text="DeepSeek es una empresa de inteligencia artificial que desarrolla modelos de lenguaje avanzados y de código abierto, accesibles a través de chat.deepseek.com."/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="Este launcher es una herramienta de acceso de Estalingrado Corp; DeepSeek es una marca y servicio independientes a los que se accede a través de este programa."/>
                </StackPanel>
            </Border>

            <Button Content="Cerrar" HorizontalAlignment="Right" Padding="22,6" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>